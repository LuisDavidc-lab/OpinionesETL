{
  "Serilog": {
    "MinimumLevel": { "Default": "Information" },
    "WriteTo": [
      { "Name": "Console" },
      {
        "Name": "File",
        "Args": {
          "path": "logs/extraccion-.log",
          "rollingInterval": "Day"
        }
      }
    ]
  },
  "ConnectionStrings": {
    "OrigenDb": "",
    "AnaliticaDb": ""
  },
  "Extraccion": {
    "EjecucionParalela": true,
    "Fuentes": {
      "Csv": {
        "Habilitada": true,
        "RutaArchivo": "data/entrada/encuestas.csv",
        "Delimitador": ","
      },
      "BaseDatos": {
        "Habilitada": true,
        "Consulta": "SELECT IdResena, Cliente, Producto, Titulo, Comentario, Estrellas, CompraVerificada, Fecha FROM dbo.ResenasOrigen",
        "TimeoutSegundos": 60
      },
      "Api": {
        "Habilitada": true,
        "UrlBase": "http://localhost:5100",
        "Ruta": "/api/comentarios",
        "TimeoutSegundos": 30,
        "MaximoReintentos": 3,
        "ApiKey": ""
      }
    }
  }
}